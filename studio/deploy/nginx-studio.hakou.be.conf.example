# studio.hakou.be — URL publique du studio (proxy Node :8787)
#
# DNS OVH (zone hakou.be) :
#   A  studio  51.178.44.114
#
# Installation :
#   sudo cp studio/deploy/nginx-studio.hakou.be.conf.example /etc/nginx/sites-available/studio.hakou.be
#   sudo ln -sf /etc/nginx/sites-available/studio.hakou.be /etc/nginx/sites-enabled/studio.hakou.be
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d studio.hakou.be
#
# Après le certificat, décommenter l’include hakou-live (HLS / WHIP sur le même host).

server {
    listen 80;
    listen [::]:80;
    server_name studio.hakou.be;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location /api/studio/recordings/ {
        proxy_pass http://127.0.0.1:8787/api/studio/recordings/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1800s;
        proxy_buffering off;
        client_max_body_size 25m;
    }

    location / {
        proxy_pass http://127.0.0.1:8787/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        client_max_body_size 25m;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # include snippets/hakou-live.conf;
}
