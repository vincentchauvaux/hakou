# Hakou Live — HLS (spectateurs) + WHIP (studio)
# Inclure dans le server HTTPS de vps-e09ed6db.vps.ovh.net :
#   include snippets/hakou-live.conf;

# HLS public
location /hakou-live/hls/ {
    proxy_pass http://127.0.0.1:8888/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Expose-Headers "*" always;
    if ($request_method = OPTIONS) {
        return 204;
    }
}

# WHIP / WebRTC signalling (publish studio)
location /hakou-live/whip/ {
    proxy_pass http://127.0.0.1:8889/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 86400s;
    proxy_redirect http://127.0.0.1:8889/ /hakou-live/whip/;
    proxy_redirect http://localhost:8889/ /hakou-live/whip/;
    client_max_body_size 4m;
    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials true always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, If-Match" always;
    add_header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Expose-Headers "Location, Link, ETag" always;
    if ($request_method = OPTIONS) {
        return 204;
    }
}
