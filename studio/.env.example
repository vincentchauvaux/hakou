# Auth / studio Hakou (VPS) — ne jamais committer ce fichier.

# Port HTTP local (nginx reverse-proxy vers celui-ci)
PORT=8787

# Google OAuth 2.0 Client ID (type « Application Web ») — public OK
# Console : https://console.cloud.google.com/apis/credentials
# Origines JS autorisées : https://hakou.be , http://localhost:3000 , https://vps-e09ed6db.vps.ovh.net
GOOGLE_CLIENT_ID=

# Client secret Google — UNIQUEMENT sur le VPS (jamais dans git ni le site statique).
# Le flux actuel vérifie l’ID token GIS avec le Client ID ; le secret sert aux échanges code futurs.
GOOGLE_CLIENT_SECRET=

# Secret pour signer le cookie de session (chaîne longue aléatoire, ex. openssl rand -hex 32)
SESSION_SECRET=

# Emails autorisés (séparés par des virgules)
ALLOWED_EMAILS=vincent.chauvaux@gmail.com,anais.motquin@gmail.com

# Optionnel — détection live YouTube plus fiable (sinon scrape /live + RSS)
# YOUTUBE_API_KEY=

# Chaîne Radio (statut public /api/radio/status)
RADIO_CHANNEL_ID=UCmm1lsi4IS7RzwFFhIax3ug
RADIO_CHANNEL_HANDLE=@MrEtibaliomecus

# —— Étape 3 : MediaMTX (WHIP → HLS) ——
MEDIAMTX_PATH=hakou
MEDIAMTX_API_BASE=http://127.0.0.1:9997
MEDIAMTX_API_USER=api
MEDIAMTX_API_PASS=
MEDIAMTX_PUBLISH_USER=publisher
MEDIAMTX_PUBLISH_PASS=
WHIP_PUBLIC_URL=https://vps-e09ed6db.vps.ovh.net/hakou-live/whip/hakou/whip
WHEP_PUBLIC_URL=https://vps-e09ed6db.vps.ovh.net/hakou-live/whip/hakou/whep
HLS_PUBLIC_URL=https://vps-e09ed6db.vps.ovh.net/hakou-live/hls/hakou/index.m3u8

# Origines CORS autorisées (site vitrine)
CORS_ORIGINS=https://hakou.be,http://localhost:3000,http://127.0.0.1:3000

# Nom / chemin du cookie session (chemin = préfixe nginx public)
SESSION_COOKIE_NAME=hakou_studio_session
SESSION_COOKIE_PATH=/hakou-studio

# —— Contact public (POST /api/contact) ——
CONTACT_TO=vincent.chauvaux@gmail.com
CONTACT_RATE_MAX=3
CONTACT_RATE_WINDOW_MS=3600000
# Secret HMAC captcha arithmétique (sinon SESSION_SECRET)
# CONTACT_CAPTCHA_SECRET=
# Optionnel — Google reCAPTCHA v2 (case à cocher) en plus du captcha maison
# CONTACT_RECAPTCHA_SITE_KEY=
# CONTACT_RECAPTCHA_SECRET=
# SMTP Gmail (mot de passe d’application) — sinon messages stockés dans data/contact-messages.jsonl
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=465
# CONTACT_SMTP_USER=vincent.chauvaux@gmail.com
# CONTACT_SMTP_PASS=
