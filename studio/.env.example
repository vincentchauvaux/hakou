# Auth / studio Hakou (VPS) — ne jamais committer ce fichier.

# Port HTTP local (nginx reverse-proxy vers celui-ci)
PORT=8787

# Google OAuth 2.0 Client ID (type « Application Web ») — public OK
# Console : https://console.cloud.google.com/apis/credentials
# Origines JS autorisées : https://hakou.be , http://localhost:3000 , https://vps-e09ed6db.vps.ovh.net
GOOGLE_CLIENT_ID=

# Client secret Google — UNIQUEMENT sur le VPS (jamais dans git ni le site statique).
# Le flux actuel vérifie l’ID token GIS avec le Client ID ; le secret sert aux échanges code futurs.
GOOGLE_CLIENT_SECRET=

# Secret pour signer le cookie de session (chaîne longue aléatoire, ex. openssl rand -hex 32)
SESSION_SECRET=

# Emails autorisés (séparés par des virgules)
ALLOWED_EMAILS=vincent.chauvaux@gmail.com

# Optionnel — détection live YouTube plus fiable (sinon scrape /live + RSS)
# YOUTUBE_API_KEY=

# Chaîne Radio (statut public /api/radio/status)
RADIO_CHANNEL_ID=UCmm1lsi4IS7RzwFFhIax3ug
RADIO_CHANNEL_HANDLE=@MrEtibaliomecus

# Origines CORS autorisées (site vitrine)
CORS_ORIGINS=https://hakou.be,http://localhost:3000,http://127.0.0.1:3000

# Nom / chemin du cookie session (chemin = préfixe nginx public)
SESSION_COOKIE_NAME=hakou_studio_session
SESSION_COOKIE_PATH=/hakou-studio
