# Variables optionnelles pour scripts Node (scripts/refresh-instagram-posts.mjs).
# Le site statique au chargement n'utilise pas ces clés — ne jamais committer .env.

# Meta Graph API (compte Instagram Business/Creator lié à une Page Facebook)
# Token long-lived « Instagram » avec droit instagram_basic — utilisé par scripts/refresh-instagram-posts.mjs (--refresh)
# Création : Meta for Developers → app → Instagram Graph → Generate token (ou échange long-lived)
# INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 — alternative au flux RSS public (non requis pour youtube-videos.js)
# YOUTUBE_API_KEY=

# Proxy CORS personnalisé si api.allorigins.win est indisponible (préfixe complet, suffixe ?url= côté JS)
# Ex. https://corsproxy.example/raw?url=
# HAKOU_CORS_PROXY_PREFIX=https://api.allorigins.win/raw?url=
