# Variables optionnelles pour scripts de rafraîchissement (scripts/refresh-instagram-posts.mjs).
# Le site statique au chargement n'utilise pas ces clés — ne jamais committer .env.

# Meta Graph API (Business/Creator) — listing posts automatisé côté serveur uniquement
# INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 — alternative au flux RSS public (non requis pour youtube-videos.js)
# YOUTUBE_API_KEY=

# Proxy CORS personnalisé si api.allorigins.win est indisponible (URL complète + ?url= en suffixe)
# HAKOU_CORS_PROXY_PREFIX=https://example.com/raw?url=
